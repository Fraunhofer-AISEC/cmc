{
    "cmc": "socket://localhost:9955",
    "provisionAuth": [ "attestation" ],
    "provisionToken": "../data/provision_token",
    "endorsement": "est:https://localhost:9000/",
    "enrollment": "est:https://localhost:9000/",
    "metadata": [
        "file://../data/metadata-signed"
    ],
    "drivers": [ "tpm", "sw" ],
    "excludePcrs": [ ],
    "hashAlg": "SHA256",
    "policyEngine": "js",
    "policyOverwrite": false,
    "logLevel": "trace",
    "storage": "../data/cmc-internal/",
    "measurementLogs": true,
    "ctrDriver": "sw",
    "ctrLog": "/tmp/container_measurements",
    "rootCas": [
        "../data/pki/ca.pem"
    ],
    "tpmKeyAlg": "EC256",
    "useOmsp": false
}
