{
    "log": {
        "level": "trace"
    },
    "api": {
        "endpoint": "socket://localhost:9955",
        "serialization": "json"
    },
    "trust": {
        "rootCas": [
            "/var/ca.pem"
        ]
    },
    "atls": {
        "addr": "0.0.0.0:4443",
        "mtls": false,
        "attest": "server"
    },
    "identity": {
        "keyId": "/var/cmcctl/key_id",
        "keyType": "tpm",
        "keyConfig": "ec256"
    },
    "publish": {
        "report": "/var/cmcctl/attestation-report",
        "result": "/var/cmcctl/attestation-result.json",
        "nonce": "/var/cmcctl/nonce",
        "caStore": "/var/ca.pem"
    }
}
