#!/bin/bash

set -euo pipefail

trap '[ $? -eq 0 ] && exit 0; printf "%s failed\n" "$0"' EXIT
dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"

metatool="${dir}/tools/metatool/metatool"

# If ssh is not specified, the reference values are parsed from the local machine. If SSH is
# specified, the reference values are parsed from the remote, where the mrtool must be installed
if [[ $# -eq 0 ]]; then
  mrtool=(sudo "${dir}/tools/mrtool/mrtool")
elif [[ $# -eq 1 ]]; then
  mrtool=("$1" mrtool)
elif [[ $# -eq 2 ]]; then
  mrtool=("$1" "$2" mrtool)
else
  echo "Usage: $(basename $0) [ssh]"
  exit 1
fi

data="${dir}/data"
out="${data}/metadata-raw"
image_description_path="${out}/image.description.json"

if [[ ! -d "${data}" ]]; then
  echo "Data directory ${data} does not exist. Did you run the setup-cmc script? Abort.."
  exit 1
fi

mkdir -p "${out}"

echo "Using ${data} as directory for local data"

set +e
gpu="Hopper"
set -e


name="de.test.gpu"

echo "Writing ${out}/gpu.manifest.json"
components='[
    {
        "type": "platform",
        "name": "NVIDIA GPU",
        "hashes": [],
        "description": "NVIDIA GPU stuff",
        "properties": [
            {
                "name": "cmc.ta",
                "value": "NVIDIA"
            },
            {
                "name": "cmc.index",
                "value": "0"
            }
        ]
    }
]'


# SHA-256 fingerprints of the NVIDIA root CAs. The device identity chain and the RIM signing
# chain are both included in the evidence, so the roots are only trusted because these fingerprints
# are part of the signed manifest.
device_ca_fingerprint="102bf659d5419614c9d8e6aecebc80454eb26b1df6a769ac720b9a690b167b48"
rim_ca_fingerprint="12977b5115acb0381179279fffeb5a8c4d264971ebb32298023a465fa41df5d1"

policy_tmp=$(mktemp)
"${metatool}" create nvidia-policy \
  --device-ca-fingerprints "${device_ca_fingerprint}" \
  --rim-ca-fingerprints "${rim_ca_fingerprint}" \
  --vbios-min-version "96.00.74.00.11" \
  --driver-min-version "595.71.05" \
  --require-ocsp-for-rims \
  --out "${policy_tmp}"



"${metatool}" create manifest \
  --name "${name}" \
  --version "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
  --developer-common-name "test developer" \
  --not-before "$(date -u +"%Y-%m-%dT%H:%M:%SZ" -d "-1 day")" \
  --not-after "$(date -u +"%Y-%m-%dT%H:%M:%SZ" -d "+2 years")" \
  --description "GPU Manifest" \
  --base-layers "${name}" \
  --details "gpu=${gpu}" \
  --nvidia-policy "${policy_tmp}" \
  --sbom-format CycloneDX \
  --components "${components}" \
  --out "${out}/gpu.manifest.json"

desc_tmp=$(mktemp)
"${metatool}" create manifest-description \
  --name "${name}.description" \
  --manifest "${name}" \
  --out "${desc_tmp}"

echo "Writing ${image_description_path}"
"${metatool}" create image-description \
  --in "${image_description_path}" \
  --add-description "${desc_tmp}" \
  --out "${image_description_path}"
rm -f "${desc_tmp}"
