#!/bin/bash

set -euo pipefail

trap '[ $? -eq 0 ] && exit 0; printf "%s failed\n" "$0"' EXIT
dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"
source "${dir}/bin/utils.sh"

bin="${dir}/bin"

ovmf="${dir}/vm/images/OVMF.fd"
vcpus=2
vmm_type=qemu

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --vcpus)
      vcpus="$2"
      shift 2
      ;;
    --vmm-type)
      vmm_type="$2"
      shift 2
      ;;
    --ovmf)
      ovmf="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: $0 [--vcpus #[,#..]] [--vmm-type TYPE] [--ovmf PATH]"
      echo "       --vcpus accepts a list (e.g. 1,2,4,8,16) to generate one alternative"
      echo "       reference value per vCPU count"
      exit 1
      ;;
  esac
done

"${bin}/generate-image-description" "snp-device.test.de"

"${bin}/precompute-rtm-manifest-snp" --vcpus "${vcpus}" --vmm-type "${vmm_type}" --ovmf "${ovmf}" --omsp "https://localhost:9000/omsp"
