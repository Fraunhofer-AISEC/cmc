[Unit]
Description=Caddy with CMC attested TLS
Documentation=https://github.com/Fraunhofer-AISEC/cmc/tree/main/tools/atlscaddy
Wants=network-online.target
After=network-online.target cmcd.service

[Service]
Type=notify
Environment=XDG_DATA_HOME=@DATADIR@ XDG_CONFIG_HOME=@DATADIR@
ExecStart=@BINDIR@/caddy-atls run --environ --config @CONFDIR@/caddy-atls.caddyfile
ExecReload=@BINDIR@/caddy-atls reload --config @CONFDIR@/caddy-atls.caddyfile --force
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=@WANTEDBY@
