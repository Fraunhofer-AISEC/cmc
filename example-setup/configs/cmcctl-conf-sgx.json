{
    "log": {
        "level": "trace"
    },
    "api": {
        "endpoint": "libapi",
        "serialization": "cbor"
    },
    "trust": {
        "rootCas": [
            "../../data/pki/ca.pem"
        ]
    },
    "atls": {
        "addr": "localhost:4443",
        "mtls": true,
        "attest": "mutual"
    },
    "identity": {
        "keyConfig": "ec256"
    },
    "files": {
        "report": "../../data/attestation-report",
        "nonce": "../../data/nonce",
        "caStore": "../../data/pki/ca.pem"
    },
    "publish": {
        "result": "../../data/attestation-result.json",
        "results": "http://nuc-02.sos.aisec.fraunhofer.de:8080/results"
    },
    "cmc": {
        "attestation": {
            "drivers": [
                "sgx"
            ],
            "measurementLogs": false
        },
        "metadata": {
            "locations": [
                "file://../../data/metadata-signed"
            ]
        },
        "provisioning": {
            "auth": [
                "none"
            ],
            "token": "../../data/provision_token",
            "endorsement": "est:https://localhost:9000/",
            "enrollment": "est:https://localhost:9000/"
        },
        "storage": {
            "data": "../../data/cmcctl-internal"
        }
    }
}
