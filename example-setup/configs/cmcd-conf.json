{
    "log": {
        "level": "trace"
    },
    "api": {
        "endpoint": "socket://localhost:9955"
    },
    "trust": {
        "rootCas": [
            "../../data/pki/ca.pem"
        ]
    },
    "cmc": {
        "attestation": {
            "drivers": [
                "tpm",
                "sw"
            ],
            "hashAlg": "sha256",
            "measurementLogs": true,
            "tpm": {
                "keyAlg": "ec256",
                "excludePcrs": []
            },
            "containers": {
                "driver": "sw",
                "log": "/tmp/container_measurements"
            }
        },
        "metadata": {
            "locations": [
                "file://../../data/metadata-signed"
            ],
            "omsp": {
                "enabled": false
            }
        },
        "provisioning": {
            "auth": [
                "attestation"
            ],
            "token": "../../data/provision_token",
            "endorsement": "est:https://localhost:9000/",
            "enrollment": "est:https://localhost:9000/"
        },
        "policies": {
            "engine": "js",
            "allowOverwrite": false
        },
        "storage": {
            "data": "../../data/cmc-internal"
        }
    }
}
