#!/bin/bash

set -euo pipefail

trap '[ $? -eq 0 ] && exit 0; printf "%s failed\n" "$0"' EXIT
dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"

data="${dir}/vm"

debug=0
edk_output_dir="RELEASE_CLANGPDB"
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--debug)
            debug=1
            edk_output_dir="DEBUG_CLANGPDB"
            shift
            ;;
        *)
            echo "Usage: $(basename "$0") [-d|--debug]"
            exit 1
            ;;
    esac
done

edk2="${data}/edk2"

# Build edk2 OVMF firmware
[ -d "${edk2}" ] || {
    printf "[\033[34;1m EXEC \033[0m] Building edk2 firmware (%s)..\n" "${edk_output_dir}"
    git clone https://github.com/tianocore/edk2.git "${edk2}"
    cd "${edk2}"
    git checkout edk2-stable202502
    git submodule update --init
}

cd "${edk2}"

make -j "$(nproc)" -C BaseTools/

# edksetup.sh does not support nounset
set +u
. ./edksetup.sh --reconfig
set -u

build_params=(  "-DTPM2_ENABLE=TRUE"
                "-DFD_SIZE_2MB"
                "-n $(nproc)"
                "-a X64"
                "-t CLANGPDB"
                "-p OvmfPkg/OvmfPkgX64.dsc")

if [[ "${debug}" -eq 1 ]]; then
    build_params+=("-b DEBUG"
        "-DDEBUG_ON_SERIAL_PORT=TRUE")
else
    build_params+=("-b RELEASE")
fi

# Build OVMF
set +u
build ${build_params[@]}
set -u

# Copy OVMF to images
install -D -m 0644 "${edk2}/Build/OvmfX64/${edk_output_dir}/FV/OVMF.fd" "${data}/images/OVMF.fd"
