#!/bin/bash

set -euo pipefail

trap '[ $? -eq 0 ] && exit 0; printf "%s failed\n" "$0"' EXIT
dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"
source "${dir}/bin/utils.sh"

drivers="tpm, vm, snp, tdx, sgx, container"

print_usage() {
  echo "Usage: $(basename "$0") [-i] [-c] [-h] <driver> [<metadata args>]"
  echo "       -i: use ids pki instead of simple pki"
  echo "       -c: use cbor instead of json for metadata"
  echo "       -h: print help"
  echo "       driver: ${drivers}"
  echo "       metadata args: passed to generate-metadata-<driver>, e.g. the artifacts folder for tdx"
}

suffix=""
serializer="json"

while getopts 'ich' flag; do
  case "${flag}" in
    i) suffix="-ids" ;;
    c) serializer="cbor" ;;
    h) print_usage
       exit 0 ;;
    *) print_usage
       exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ "$#" -lt 1 ]]; then
  print_usage
  exit 1
fi

driver="${1}"
shift

if [[ ! -x "${dir}/bin/generate-metadata-${driver}" ]]; then
  echo "Error: invalid driver ${driver}. Expected one of ${drivers}"
  exit 1
fi

require_bins metatool mrtool

data="${dir}/data"

if [[ -d "${data}" ]]; then
  echo "Data directory ${data} does already exist. Remove it for a fresh setup. Abort.."
  exit 1
fi

echo "Using ${data} as directory for local data"
mkdir -p "${data}"

# Generate an example PKI
"${dir}/bin/setup-pki${suffix}"

# Generate example metadata for the current machine
"${dir}/bin/generate-metadata-${driver}" "$@"

# Sign the metadata
echo "Signing metadata with serializer ${serializer}"
"${dir}/bin/sign-metadata${suffix}" "${serializer}"

# Generate the OMSP responses for the signed manifests
"${dir}/bin/generate-omsp-responses"
