#!/bin/bash

set -euo pipefail

trap '[ $? -eq 0 ] && exit 0; printf "%s failed\n" "$0"' EXIT
dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"

# Builds the AWS EC2 OVMF firmware, required to precompute the SNP reference values of EC2 VMs
data="${dir}/vm"
uefi="${data}/uefi-aws"
out="${data}/images/OVMF-AWS.fd"

command -v nix-build >/dev/null || {
  echo "Error: nix-build not found. Building the AWS firmware requires Nix, see https://nixos.org/download"
  exit 1
}

[[ -d "${uefi}" ]] || git clone https://github.com/aws/uefi.git "${uefi}"

cd "${uefi}"
nix-build --pure

install -D -m 0644 "${uefi}/result/ovmf_img.fd" "${out}"
echo "Wrote ${out}"
