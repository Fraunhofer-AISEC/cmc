#!/bin/bash

set -euo pipefail

trap '[ $? -eq 0 ] && exit 0; printf "%s failed\n" "$0"' EXIT
dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"
source "${dir}/bin/utils.sh"

require_bins cmcd cmcctl mrtool

# Stop running services in VM
"${dir}/bin/vm-ssh" systemctl stop cmcctl cmcd

# Remove cmcd data to enforce generation of new certs
"${dir}/bin/vm-ssh" rm -rf /var/lib/cmc/cmcd

# Copy the installed binaries into VM
"${dir}/bin/vm-scp" "$(command -v cmcd)" "$(command -v cmcctl)" "$(command -v mrtool)" vm-ubuntu:/usr/bin/

# Restart services
"${dir}/bin/vm-ssh" systemctl start cmcd cmcctl
