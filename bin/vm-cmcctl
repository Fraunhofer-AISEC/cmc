#!/bin/bash

set -euo pipefail

trap '[ $? -eq 0 ] && exit 0; printf "%s failed\n" "$0"' EXIT
dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"
source "${dir}/bin/utils.sh"

require_bins cmcctl

cmd="${1:-request}"
if [ "$#" -gt 0 ]; then
  shift
fi

cd "${dir}"

exec cmcctl "${cmd}" --config "${dir}/example-setup/vm-config/cmcctl-host.toml" "$@"
