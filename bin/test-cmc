#!/bin/bash

set -euo pipefail

dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"
source "${dir}/bin/utils.sh"

data="${dir}/data"

# Seconds to wait for a component to report readiness before the run is considered failed
wait_timeout=120
# Lines of component output shown when a step fails
log_tail_lines=30

# Cleanup to kill all running processes
trap "exit" INT TERM
trap cleanup EXIT

cleanup() {

    local rc=$?

    if [[ ! ${rc} -eq 0 ]]; then
        printf "[\033[31;1mFAILED\033[0m]\nCleaning up..\n"
        if [[ -d "${log_dir:-}" ]]; then
            printf "Logs: %s\n" "${log_dir}"
        fi
    fi
    if [[ -n "${sudo_keepalive_pid:-}" ]]; then
        kill "${sudo_keepalive_pid}" > /dev/null 2>&1 || true
    fi
    kill_process "cmcd"
    kill_process "cmcctl"
    kill_process "estserver"
    if [[ -t 0 ]]; then
        stty sane
    fi

    exit "${rc}"
}

kill_process() {
    local process_name=$1
    set +e

    pid=$(pgrep -x "$process_name")
    if [ ! -n "$pid" ]; then
        set -e
        return
    fi

    pkill -SIGINT "${process_name}" > /dev/null 2>&1
    if [ $? -eq 1 ]; then
        sudo -n pkill -SIGINT "${process_name}" > /dev/null 2>&1
        if [ $? -eq 1 ]; then
            printf "FAIL\n"
            set -e
            return
        fi
    fi

    sleep 0.2

    if pgrep -x "${process_name}" > /dev/null; then
        sudo -n pkill -9 "${process_name}" > /dev/null 2>&1
        sleep 0.2
    fi

    if pgrep -x "${process_name}" > /dev/null; then
        echo "Failed to kill ${process_name}"
        exit 1
    fi

    set -e
    return
}


# Function to wait for a specific message in a process's output
wait_for_message() {
    local process_pid=$1
    local output_file=$2
    local message=$3
    local timeout=${4:-${wait_timeout}}

    local deadline=$(( SECONDS + timeout ))

    while kill -0 ${process_pid} 2>/dev/null; do
        sleep 0.3
        if [[ -f "${output_file}" ]]; then
            if grep -q "${message}" "${output_file}"; then
                return 0
            fi
        fi
        # Without a timeout, a component that starts but never becomes ready would hang the
        # whole run until the CI job is killed
        if (( SECONDS >= deadline )); then
            printf "\nTimeout after %ss waiting for '%s' in logfile %s\n" \
                "${timeout}" "${message}" "${output_file}"
            print_log_tail "${output_file}"
            return 1
        fi
    done

    # Final check after process exited
    sleep 0.3
    if [[ -f "${output_file}" ]] && grep -q "${message}" "${output_file}"; then
        return 0
    fi

    printf "\nExpected message: '%s' not found in logfile %s\n" "${message}" "${output_file}"
    print_log_tail "${output_file}"
    return 1
}

print_log_tail() {
    local output_file=$1

    if [[ -f "${output_file}" ]]; then
        printf -- "--- last %s lines of %s ---\n" "${log_tail_lines}" "${output_file}"
        tail -n "${log_tail_lines}" "${output_file}"
        printf -- "---\n"
    fi
}

# Assert that a component logged the expected message, showing the log on failure so that a CI
# run reports why it failed instead of only that it failed
check_message() {
    local output_file=$1
    local message=$2

    if ! grep -q "${message}" "${output_file}"; then
        printf "\nExpected message: '%s' not found in logfile %s\n" "${message}" "${output_file}"
        print_log_tail "${output_file}"
        print_log_tail "${output_file}.out"
        return 1
    fi
}


if [[ ! -d "${data}" ]]; then
  echo "Data directory ${data} does not exist. Did you run the setup-cmc script? Abort.."
  exit 1
fi

log_dir="${data}/logs"

metadata_raw="${data}/metadata-raw"
metadata_signed="${data}/metadata-signed"
omsp_data="${data}/omsp-raw"
storage="${data}/cmc-internal"
cache="${data}/cmc-cache"
peercache="${data}/cmc-peer-cache"
ctrlog="${data}/cmc-container-measurements"
hostname="$(hostname --fqdn 2>/dev/null || hostname)"

est_params=(
    "--est-addr"            "0.0.0.0:9000" \
    "--est-ca-key"          "${data}/pki/ca-key.pem" \
    "--est-ca-chain"        "${data}/pki/ca.pem" \
    "--root-cas"            "${data}/pki/ca.pem" \
    "--http-folder"         "${data}" \
    "--tpm-ek-cert-db"      "${data}/tpm-ek-certs.db" \
    "--tls-key"             "${data}/pki/est-tls-key.pem" \
    "--tls-ca-chain"        "${data}/pki/est-tls.pem" \
    "--log-level"           "trace" \
    "--log-file"            "${log_dir}/estserver.log" \
    "--auth-methods"        "none" \
    "--verify-ek-cert=false" \
    "--omsp-folder"           "${data}/omsp-raw" \
    "--omsp-key"              "${data}/pki/omsp-key.pem" \
    "--omsp-ca-chain"         "${data}/pki/omsp.pem" \
    "--omsp-url"              "https://localhost:9000/omsp" \
)

cmc_params=(
    "--cmc-addr" "127.0.0.1:9955" \
    "--provision-auth" "none" \
    "--endorsement-mode" "est" \
    "--endorsement-addr" "https://localhost:9000" \
    "--enrollment-mode" "est" \
    "--enrollment-addr" "https://localhost:9000" \
    "--metadata" "file://${metadata_signed}" \
    "--drivers" "tpm,sw" \
    "--hash-alg" "sha256" \
    "--log-level" "trace" \
    "--storage" "${storage}" \
    "--cache" "${cache}"
    "--peer-cache" "${peercache}" \
    "--measurement-logs" \
    "--ctr" \
    "--ctr-driver" "sw" \
    "--ctr-log" "${ctrlog}" \
    "--root-cas" "${data}/pki/ca.pem" \
    "--tpm-key-alg" "EC256" \
    "--use-omsp=true" \
)

cmcctl_params=(
    "--report" "attestation-report" \
    "--result" "attestation-result.json" \
    "--nonce" "nonce" \
    "--root-cas" "${data}/pki/ca.pem" \
    "--mtls" \
    "--attest" "mutual" \
    "--log-level" "trace" \
    "--cmc-addr" "127.0.0.1:9955" \
    "--key-config" "EC256" \
    "--key-type" "tpm" \
    "--key-id" "${data}/key-id" \
)

attest_success=("success" "fail")

ar_serializers=("json" "cbor")

api_serializers=("json" "cbor")

omsp_serializers=("json" "cbor")

protocols=("grpc" "coap" "socket")

commands_server=("generate" "listen" "serve")

commands_params_server=("" "--addr 0.0.0.0:4443" "--addr 0.0.0.0:8082")

commands_client=("verify" "dial" "request")

commands_params_client=("" "--addr ${hostname}:4443" "--addr https://${hostname}:8082/post --method POST --data \"hello ahttps\"")

commands_server_ready_msg=("Wrote attestation response" "Serving under" "Serving HTTPS under")

commands_server_success_msg=("Wrote attestation response" "Server-side aTLS connection complete" "Server-side aHTTPS request completed")
commands_client_success_msg=("SUCCESS: Verification for Prover" "Client-side aTLS connection complete" "Client-side aHTTPS request completed")

commands_server_fail_msg=("Wrote attestation response" "attestation report verification failed" "attestation report verification failed")
commands_client_fail_msg=("FAILED: Verification for Prover" "attestation report verification failed" "attestation report verification failed")

# Update binaries
echo "Updating binaries..."
go build -C "${dir}/cmcd"
go build -C "${dir}/cmcctl"
go build -C "${dir}/tools/estserver"
go build -C "${dir}/tools/mrtool"
go build -C "${dir}/tools/metatool"

# The components need root privileges for TPM and measurement log access. They are started
# detached from the terminal and can therefore neither prompt for a password nor be answered, so
# make sure sudo works non-interactively before anything is started
sudo_keepalive_pid=""
if ! sudo -n true > /dev/null 2>&1; then
    if [[ ! -t 0 ]]; then
        echo "sudo requires a password, but there is no terminal to prompt on."
        echo "Configure passwordless sudo for this user. Abort.."
        exit 1
    fi
    echo "Caching sudo credentials for the test run.."
    sudo -v
    # The matrix runs longer than the sudo timestamp timeout, so refresh the credentials
    while true; do
        sleep 50
        sudo -n -v < /dev/null > /dev/null 2>&1 || exit
    done &
    sudo_keepalive_pid=$!
    disown
fi

# Clean start
echo "Wiping internal folders for fresh start..."
sudo -n rm -rf "${metadata_raw}"
sudo -n rm -rf "${metadata_signed}"
sudo -n rm -rf "${omsp_data}"
sudo -n rm -rf "${storage}"
sudo -n rm -rf "${cache}"
sudo -n rm -rf "${peercache}"
sudo -n rm -rf "${log_dir}"

mkdir -p "${log_dir}"

# Start est server
echo "Starting est server..."
setsid -w sudo -n "${dir}/tools/estserver/estserver" "${est_params[@]}" \
    < /dev/null > "${log_dir}/estserver.out" 2>&1 &
disown
sleep 0.2

echo "Performing tests"

# Test matrix
for success in "${attest_success[@]}"
do
    for ar_serializer in "${ar_serializers[@]}"
    do
        metadata_log="${log_dir}/metadata_${ar_serializer}.log"

        # Generate metadata for serializer (do not generate app manifest for failed attestation test)
        echo "Generating ${ar_serializer} metadata ======================================================="
        generate-image-description > "${metadata_log}" 2>&1
        generate-rtm-manifest-tpm --omsp "https://localhost:9000/omsp" >> "${metadata_log}" 2>&1
        generate-os-manifest-tpm --omsp "https://localhost:9000/omsp" >> "${metadata_log}" 2>&1
        if [[ "${success}" == "success" ]]; then
            generate-app-manifest-tpm --omsp "https://localhost:9000/omsp" >> "${metadata_log}" 2>&1
        fi
        sign-metadata "${ar_serializer}" >> "${metadata_log}" 2>&1
        generate-omsp-responses >> "${metadata_log}" 2>&1

        # Test CMC with the parameter matrix
        for api_serializer in "${api_serializers[@]}"
        do
            for omsp_serializer in "${omsp_serializers[@]}"
            do
                for i in "${!protocols[@]}"
                do
                    cmc_log="${log_dir}/cmcd_${success}_${ar_serializer}_${api_serializer}_${omsp_serializer}_${protocols[i]}.log"

                    echo "Starting cmcd"
                    setsid -w sudo -n "${dir}/cmcd/cmcd" \
                        "${cmc_params[@]}" \
                        --log-file "${cmc_log}" \
                        --omsp-format "${omsp_serializer}" \
                        --api "${protocols[i]}" \
                        < /dev/null > "${cmc_log}.out" 2>&1 \
                        &
                    cmc_pid="$!"
                    disown
                    wait_for_message "$cmc_pid" "${cmc_log}" "Waiting for.*requests"
                    echo "Restarted cmcd -----------------------------------------------------------------"

                    for j in "${!commands_server[@]}"
                    do
                        server_log="${log_dir}/cmcctl_${success}_${ar_serializer}_${api_serializer}_${omsp_serializer}_${protocols[i]}_${commands_server[j]}.log"
                        client_log="${log_dir}/cmcctl_${success}_${ar_serializer}_${api_serializer}_${omsp_serializer}_${protocols[i]}_${commands_client[j]}.log"

                        printf "TEST CMD %-8s | ATT %-7s | AR %s | SER %s | OMSP %s | API %-6s\t" "${commands_client[j]}" "${success}" "${ar_serializer}" "${api_serializer}" "${omsp_serializer}" "${protocols[i]}"

                        setsid -w "${dir}/cmcctl/cmcctl" \
                            "${commands_server[j]}" \
                            "${cmcctl_params[@]}" \
                            --log-file "${server_log}" \
                            --api ${protocols[i]} \
                            --serialization ${api_serializer} \
                            ${commands_params_server[j]} \
                            < /dev/null > "${server_log}.out" 2>&1 \
                            &
                        disown
                        wait_for_message $! "${server_log}" "${commands_server_ready_msg[j]}"

                        set +e
                        setsid -w timeout "${wait_timeout}" "${dir}/cmcctl/cmcctl" \
                            "${commands_client[j]}" \
                            "${cmcctl_params[@]}" \
                            --log-file "${client_log}" \
                            --serialization "${api_serializer}" \
                            --api "${protocols[i]}" \
                            ${commands_params_client[j]} \
                            < /dev/null > "${client_log}.out" 2>&1
                        set -e

                        if [[ "${success}" == "success" ]]; then
                            wait_msg_server="${commands_server_success_msg[j]}"
                            wait_msg_client="${commands_client_success_msg[j]}"
                        else
                            wait_msg_server="${commands_server_fail_msg[j]}"
                            wait_msg_client="${commands_client_fail_msg[j]}"
                        fi

                        # Verify the server and client output
                        check_message "${server_log}" "${wait_msg_server}"
                        check_message "${client_log}" "${wait_msg_client}"
                        printf "[\033[32;1m  OK  \033[0m]\n"

                        kill_process "cmcctl"
                    done
                    kill_process "cmcd"
                done
            done
        done
    done
done

echo "Finished"
