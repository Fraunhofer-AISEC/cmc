#!/bin/bash

set -euo pipefail

trap '[ $? -eq 0 ] && exit 0; printf "%s failed\n" "$0"' EXIT
dir="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)"

[[ $# -eq 0 ]] || {
    echo "Usage: $(basename $0)"
    exit 1
}

artifacts="${dir}/vm/artifacts/"

echo "Writing artifacts to ${artifacts}"

cmdline="${artifacts}/cmdline"
initrd="initrd.img"
efi_shim="shimx64.efi"
grub="grubx64.efi"
kernel_version=$("${dir}/bin/vm-ssh" uname -r)
kernel="vmlinuz-${kernel_version}"

echo "Retrieved kernel version ${kernel_version}"

# Retrieve artifacts
mkdir -p "${artifacts}"

# Fetch efivars
echo "Fetching efivars..."
"${dir}/bin/vm-ssh" 'tar czf - -C /sys/firmware/efi efivars' | tar xzf - -C "${artifacts}"

# Fetch commandline
echo "Fetching cmdline..."
"${dir}/bin/vm-ssh" cat /proc/cmdline > "${artifacts}/cmdline"

# Fetch GPT table
"${dir}/bin/vm-retrieve-gpt"

# Fetch kernel image
echo "Fetching kernel..."
"${dir}/bin/vm-ssh" "cat /boot/${kernel}" > "${artifacts}/vmlinuz"

# Fetch initrd
echo "Fetching initrd..."
"${dir}/bin/vm-ssh" "cat /boot/${initrd}" > "${artifacts}/initrd"

# Fetch shim
echo "Fetching shim..."
"${dir}/bin/vm-ssh" "cat /boot/efi/EFI/ubuntu/${efi_shim}" > "${artifacts}/${efi_shim}"

# Fetch GRUB
echo "Fetching grub..."
"${dir}/bin/vm-ssh" "cat /boot/efi/EFI/ubuntu/${grub}" > "${artifacts}/${grub}"

# Get grub files
echo "Fetching grub files"
"${dir}/bin/vm-ssh" 'tar czf - -C /boot/ grub' | tar xzf - -C "${artifacts}"
