{
    "log": {
        "level": "trace"
    },
    "api": {
        "endpoint": "socket://localhost:9955",
        "serialization": "json"
    },
    "trust": {
        "rootCas": [
            "../../data/pki/ca.pem"
        ]
    },
    "atls": {
        "addr": "localhost:4443",
        "mtls": true,
