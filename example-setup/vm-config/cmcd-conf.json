{
    "log": {
        "level": "trace"
    },
    "api": {
        "endpoint": "socket://0.0.0.0:9955"
    },
    "trust": {
        "rootCas": [
            "/var/metadata-ca.pem",
            "/var/ca.pem"
        ]
    },
    "cmc": {
        "attestation": {
            "drivers": [
                "tpm",
                "sw"
            ],
            "hashAlg": "sha256",
            "measurementLogs": true,
            "tpm": {
                "keyAlg": "ec256"
            },
            "containers": {
                "driver": "sw",
                "log": "/tmp/container_measurements"
            }
        },
        "metadata": {
            "locations": [
                "https://10.0.2.2:9000/vm-metadata"
            ],
            "omsp": {
                "enabled": true,
                "format": "json"
            }
        },
        "provisioning": {
            "auth": [
                "none"
            ],
            "endorsement": "est:https://10.0.2.2:9000/",
            "enrollment": "est:https://10.0.2.2:9000/"
        },
        "storage": {
            "data": "/var/cmc/internal"
        }
    }
}
